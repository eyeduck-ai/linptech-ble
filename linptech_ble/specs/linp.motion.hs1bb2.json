{
  "type": "urn:miot-spec-v2:device:motion-sensor:0000A014:linp-hs1bb2:1",
  "description": "Motion Sensor",
  "services": [
    {
      "iid": 1,
      "type": "urn:miot-spec-v2:service:device-information:00007801:linp-hs1bb2:1",
      "description": "Device Information",
      "properties": [
        {
          "iid": 1,
          "type": "urn:miot-spec-v2:property:manufacturer:00000001:linp-hs1bb2:1",
          "description": "Device Manufacturer",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 2,
          "type": "urn:miot-spec-v2:property:model:00000002:linp-hs1bb2:1",
          "description": "Device Model",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 3,
          "type": "urn:miot-spec-v2:property:serial-number:00000003:linp-hs1bb2:1",
          "description": "Device ID",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 4,
          "type": "urn:miot-spec-v2:property:firmware-revision:00000005:linp-hs1bb2:1",
          "description": "Current Firmware Version",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 5,
          "type": "urn:miot-spec-v2:property:serial-no:000000FF:linp-hs1bb2:1",
          "description": "Serial Number",
          "format": "string",
          "access": [
            "read",
            "notify"
          ]
        }
      ]
    },
    {
      "iid": 2,
      "type": "urn:miot-spec-v2:service:motion-sensor:00007825:linp-hs1bb2:1",
      "description": "Motion Sensor",
      "properties": [
        {
          "iid": 1005,
          "type": "urn:miot-spec-v2:property:illumination:0000004E:linp-hs1bb2:1",
          "description": "Illumination",
          "format": "float",
          "access": [
            "notify",
            "read"
          ],
          "unit": "lux",
          "value-range": [
            0,
            1000,
            1
          ],
          "source": 1,
          "gatt-access": []
        },
        {
          "iid": 1024,
          "type": "urn:miot-spec-v2:property:no-motion-duration:000000CB:linp-hs1bb2:1",
          "description": "No Motion Duration",
          "format": "uint16",
          "access": [
            "notify",
            "read"
          ],
          "unit": "seconds",
          "value-range": [
            0,
            65535,
            1
          ],
          "source": 1
        },
        {
          "iid": 2,
          "type": "urn:miot-spec-v2:property:custom-detect-interval:0000029C:linp-hs1bb2:1",
          "description": "Custom Detect Interval",
          "format": "uint16",
          "access": [],
          "unit": "seconds",
          "value-range": [
            10,
            50,
            10
          ],
          "source": 3,
          "gatt-access": [
            "read",
            "write",
            "notify"
          ]
        },
        {
          "iid": 1053,
          "type": "urn:miot-spec-v2:property:custom-no-motion-time:0000029D:linp-hs1bb2:1",
          "description": "Custom No Motion Time",
          "format": "uint16",
          "access": [
            "notify",
            "read"
          ],
          "unit": "minutes",
          "value-range": [
            1,
            60,
            1
          ],
          "source": 4,
          "gatt-access": [
            "read",
            "write",
            "notify"
          ]
        }
      ],
      "events": [
        {
          "iid": 1028,
          "type": "urn:miot-spec-v2:event:device-be-reset:0000503C:linp-hs1bb2:1",
          "description": "Device Be Reset",
          "arguments": []
        },
        {
          "iid": 1008,
          "type": "urn:miot-spec-v2:event:motion-detected:00005001:linp-hs1bb2:1",
          "description": "Motion Detected",
          "arguments": [
            1005
          ]
        }
      ]
    },
    {
      "iid": 3,
      "type": "urn:miot-spec-v2:service:battery:00007805:linp-hs1bb2:1",
      "description": "Battery",
      "properties": [
        {
          "iid": 1003,
          "type": "urn:miot-spec-v2:property:battery-level:00000014:linp-hs1bb2:1",
          "description": "Battery Level",
          "format": "uint8",
          "access": [
            "notify",
            "read"
          ],
          "unit": "percentage",
          "value-range": [
            0,
            100,
            1
          ],
          "source": 1
        }
      ]
    },
    {
      "iid": 4,
      "type": "urn:miot-spec-v2:service:indicator-light:00007803:linp-hs1bb2:1",
      "description": "Indicator Light",
      "properties": [
        {
          "iid": 1,
          "type": "urn:miot-spec-v2:property:on:00000006:linp-hs1bb2:1",
          "description": "Switch Status",
          "format": "bool",
          "access": [],
          "source": 3,
          "gatt-access": [
            "read",
            "write",
            "notify"
          ]
        }
      ]
    },
    {
      "iid": 5,
      "type": "urn:linp-spec:service:custom-cfg:00007801:linp-hs1bb2:1",
      "description": "custom-cfg",
      "properties": [
        {
          "iid": 1,
          "type": "urn:linp-spec:property:custom-no-one-time-a:00000001:linp-hs1bb2:1",
          "description": "custom-no-one-time-a",
          "format": "uint16",
          "access": [],
          "unit": "seconds",
          "value-range": [
            60,
            3600,
            1
          ],
          "source": 3,
          "gatt-access": [
            "read",
            "write"
          ]
        },
        {
          "iid": 2,
          "type": "urn:linp-spec:property:custom-no-one-time-b:00000002:linp-hs1bb2:1",
          "description": "custom-no-one-time-b",
          "format": "uint16",
          "access": [],
          "unit": "seconds",
          "value-range": [
            60,
            3600,
            1
          ],
          "source": 3,
          "gatt-access": [
            "read",
            "write"
          ]
        },
        {
          "iid": 3,
          "type": "urn:linp-spec:property:pir-single-report:00000003:linp-hs1bb2:1",
          "description": "pir-single-report",
          "format": "bool",
          "access": [],
          "source": 3,
          "gatt-access": [
            "read",
            "write"
          ]
        }
      ]
    }
  ]
}
