{
  "version": 1,
  "bluetooth": {
    "backend": "esphome",
    "proxies": [
      {
        "name": "bedroom",
        "host": "192.0.2.10",
        "port": 6053,
        "noise_psk": "REPLACE_WITH_THIS_PROXY_API_KEY_BASE64"
      }
    ],
    "gatt_proxy": "bedroom",
    "connect_timeout": 15
  },
  "mqtt": {
    "enabled": false,
    "host": "192.0.2.20",
    "port": 1883,
    "username": "REPLACE_WITH_BRIDGE_MQTT_LOGIN",
    "password": "REPLACE_WITH_BRIDGE_MQTT_PASSWORD",
    "topic_prefix": "linptech_ble",
    "discovery_prefix": "homeassistant",
    "client_id": "linptech-ble",
    "tls": false,
    "stale_after": 180,
    "battery_stale_after": 86400,
    "poll_interval": 1
  },
  "es5": {
    "auto_connect": false,
    "retry_seconds": 30
  }
}
