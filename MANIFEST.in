include README.md LICENSE THIRD_PARTY_NOTICES.md CONTRIBUTING.md pyproject.toml
include docs/README.md
include docs/VALIDATION.md
include docs/LIBRARY.md docs/DEVICE_CAPABILITIES.md docs/DIRECT_PROTOCOL.md docs/DEVTOOLS.md
include docs/DASHBOARD_WINDOWS.md docs/SIGNAL_QUALITY.md docs/ESPHOME_PROXY.md
include docs/BINDKEY_WINDOWS.md docs/ES5BB_ADVANCED.md examples/README.md
include docs/HARDWARE_VALIDATION.md
include docs/CAPABILITY_API.md docs/PIR_INVESTIGATION.md docs/HS3BB_WAKE.md
include examples/library_*.py
include examples/transport.example.json examples/esphome-proxy-wifi.yaml examples/esphome-proxy-ethernet.yaml
recursive-include linptech_ble *.py
recursive-include linptech_ble *.pyi
include linptech_ble/py.typed
recursive-include linptech_ble/web *.html *.css *.js *.svg
recursive-include linptech_ble/specs *.json
prune .private
prune .tools
prune .venv
prune .git
prune .agents
prune .codex
prune .aws
prune .pytest_cache
prune .mypy_cache
prune .playwright-cli
prune captures
prune output
prune tests
prune specs
prune dist
prune build
global-exclude *.py[cod] *.local.json *.local.yaml *.local.yml *.secrets.json secrets.yaml secrets.yml
