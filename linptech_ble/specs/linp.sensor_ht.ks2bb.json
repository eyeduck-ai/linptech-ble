{
  "type": "urn:miot-spec-v2:device:temperature-humidity-sensor:0000A00A:linp-ks2bb:1",
  "description": "Temperature Humidity Sensor",
  "services": [
    {
      "iid": 1,
      "type": "urn:miot-spec-v2:service:device-information:00007801:linp-ks2bb:1",
      "description": "Device Information",
      "properties": [
        {
          "iid": 1,
          "type": "urn:miot-spec-v2:property:manufacturer:00000001:linp-ks2bb:1",
          "description": "Device Manufacturer",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 2,
          "type": "urn:miot-spec-v2:property:model:00000002:linp-ks2bb:1",
          "description": "Device Model",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 3,
          "type": "urn:miot-spec-v2:property:serial-number:00000003:linp-ks2bb:1",
          "description": "Device ID",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 4,
          "type": "urn:miot-spec-v2:property:firmware-revision:00000005:linp-ks2bb:1",
          "description": "Current Firmware Version",
          "format": "string",
          "access": [
            "read"
          ]
        },
        {
          "iid": 5,
          "type": "urn:miot-spec-v2:property:serial-no:000000FF:linp-ks2bb:1",
          "description": "Serial Number",
          "format": "string",
          "access": [
            "read",
            "notify"
          ]
        }
      ]
    },
    {
      "iid": 2,
      "type": "urn:miot-spec-v2:service:temperature-humidity-sensor:00007814:linp-ks2bb:1",
      "description": "Temperature Humidity Sensor",
      "properties": [
        {
          "iid": 1001,
          "type": "urn:miot-spec-v2:property:temperature:00000020:linp-ks2bb:1",
          "description": "Temperature",
          "format": "float",
          "access": [
            "notify",
            "read"
          ],
          "unit": "celsius",
          "value-range": [
            -30,
            100,
            0.1
          ],
          "source": 1,
          "gatt-access": []
        },
        {
          "iid": 1002,
          "type": "urn:miot-spec-v2:property:relative-humidity:0000000C:linp-ks2bb:1",
          "description": "Relative Humidity",
          "format": "uint8",
          "access": [
            "notify",
            "read"
          ],
          "unit": "percentage",
          "value-range": [
            0,
            99,
            1
          ],
          "source": 1,
          "gatt-access": []
        }
      ]
    },
    {
      "iid": 4,
      "type": "urn:miot-spec-v2:service:battery:00007805:linp-ks2bb:1",
      "description": "Battery",
      "properties": [
        {
          "iid": 1003,
          "type": "urn:miot-spec-v2:property:battery-level:00000014:linp-ks2bb:1",
          "description": "Battery Level",
          "format": "uint8",
          "access": [
            "notify",
            "read"
          ],
          "unit": "percentage",
          "value-range": [
            0,
            100,
            1
          ],
          "source": 1
        }
      ]
    },
    {
      "iid": 5,
      "type": "urn:miot-spec-v2:service:switch-sensor-for-ble:000078B0:linp-ks2bb:1",
      "description": "Switch Sensor For BLE",
      "events": [
        {
          "iid": 1012,
          "type": "urn:miot-spec-v2:event:click:00005007:linp-ks2bb:1",
          "description": "Click",
          "arguments": []
        },
        {
          "iid": 1013,
          "type": "urn:miot-spec-v2:event:double-click:00005008:linp-ks2bb:1",
          "description": "Double Click",
          "arguments": []
        },
        {
          "iid": 1014,
          "type": "urn:miot-spec-v2:event:long-press:00005009:linp-ks2bb:1",
          "description": "Long Press",
          "arguments": []
        },
        {
          "iid": 1028,
          "type": "urn:miot-spec-v2:event:device-be-reset:0000503C:linp-ks2bb:1",
          "description": "Device Be Reset",
          "arguments": []
        }
      ]
    },
    {
      "iid": 6,
      "type": "urn:linp-spec:service:vendor:00007801:linp-ks2bb:1",
      "description": "vendor",
      "properties": [
        {
          "iid": 1,
          "type": "urn:linp-spec:property:mode:00000001:linp-ks2bb:1",
          "description": "mode",
          "format": "uint8",
          "access": [],
          "value-list": [
            {
              "value": 0,
              "description": "Multiple Click"
            },
            {
              "value": 1,
              "description": "Quick Single Click"
            }
          ],
          "source": 3,
          "gatt-access": [
            "read",
            "write",
            "notify"
          ]
        },
        {
          "iid": 2,
          "type": "urn:linp-spec:property:temp-c-f:00000002:linp-ks2bb:1",
          "description": "temp-c-f",
          "format": "uint8",
          "access": [],
          "value-list": [
            {
              "value": 0,
              "description": "Temp-C"
            },
            {
              "value": 1,
              "description": "Temp-F"
            }
          ],
          "source": 3,
          "gatt-access": [
            "read",
            "write"
          ]
        }
      ]
    }
  ]
}
